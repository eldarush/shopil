# Documentation only: ShopIL does NOT automatically load this file.
# Set these variables in your shell, or pass the matching CLI flags.
# Relative paths below are resolved from the process working directory.

# Required unless provided by --warehouse, --history-start, --history-end, --model.
SHOPIL_WAREHOUSE=../etl-course-demo/warehouse.duckdb
SHOPIL_HISTORY_START=2026-01-01
SHOPIL_HISTORY_END=2027-01-01
# Replace with a model already installed in your local Ollama server.
SHOPIL_MODEL=YOUR_INSTALLED_MODEL

# Optional defaults. The server URL must be loopback and contain no credentials.
SHOPIL_STREAM_DB=runs/stream.db
SHOPIL_OLLAMA_URL=http://127.0.0.1:11434
SHOPIL_AUDIT_DIR=runs/audit

# --port and --latest-windows are CLI-only; no SHOPIL_* variables exist for them.
# No API key is required for this local transport. Do not put secrets here.
