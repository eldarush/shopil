# Set these in the shell when overriding the quick-start defaults.
# Values are examples. The application does not load this file automatically.
SHOPIL_MODEL=qwen3:8b
SHOPIL_OLLAMA_URL=http://127.0.0.1:11434

# Standalone chat: replace SESSION with a completed demo session directory.
SHOPIL_WAREHOUSE=runs/SESSION/course/warehouse.duckdb
SHOPIL_STREAM_DB=runs/SESSION/stream.db
SHOPIL_HISTORY_START=2026-01-01
SHOPIL_HISTORY_END=2027-01-01
SHOPIL_AUDIT_DIR=runs/SESSION/audit
